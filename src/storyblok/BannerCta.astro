---
import { storyblokEditable } from '@storyblok/astro'
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro'
const { blok } = Astro.props
---

<section id={blok.anchor_id} {
  ...storyblokEditable(blok)}
  class="relative overflow-hidden w-full banner-cta-section"
  >

  <!-- Background image with parallax support -->
  <div
    class="absolute left-0 w-full bg-no-repeat bg-cover bg-center parallax-bg z-0 will-change-transform"
    style={`height: 180%; top: -40%; background-image: ${blok.image?.filename ? `url('${blok.image.filename}/m/1440x0/filters:quality(90)')` : ''}`}
  ></div>

  <!-- Dark transparent overlay -->
  <div class="absolute inset-0 bg-black/60 z-0 pointer-events-none mix-blend-multiply"></div>

  <!-- Content container -->
  <div class="relative z-10 container mx-auto flex flex-col justify-between items-start min-h-[80vh] py-16 px-6">

    {blok.heading && blok.heading.length > 0 && (
      <StoryblokComponent blok={blok.heading[0]} />
    )}

    <div class="max-w-[474px]">
      <h2 class="text-white text-3xl md:text-5xl leading-[120%] font-adamina mb-10">{blok.headline}</h2>
      {blok.button && blok.button.length > 0 && (
        <StoryblokComponent blok={blok.button[0]} />
      )}
    </div>
  </div>

</section>

<script>
  // Ensure we don't attach multiple listeners across page transitions
  let parallaxInitialized = false;
  let parallaxRafId: number | null = null;

  function handleParallaxScroll() {
    if (!parallaxRafId) {
      parallaxRafId = requestAnimationFrame(updateParallax);
    }
  }

  function updateParallax() {
    const sections = document.querySelectorAll('.banner-cta-section');
    sections.forEach(section => {
      const bg = section.querySelector('.parallax-bg') as HTMLElement;
      if (!bg) return;

      const rect = section.getBoundingClientRect();

      // Check if section is visible in viewport
      if (rect.top <= window.innerHeight && rect.bottom >= 0) {
        // Calculate parallax offset based on scroll position relative to the element
        const totalDistance = window.innerHeight + rect.height;
        const currentDistance = window.innerHeight - rect.top;
        const scrollProgress = Math.max(0, Math.min(1, currentDistance / totalDistance));

        // The background is height: 180%, top: -40%.
        // This gives us 40% of extra space at the top and 40% extra at the bottom.
        // We can safely move it +/- 35% of the section height for a strong effect without revealing gaps.
        const maxMovement = rect.height * 0.35;

        // Calculate offset (-maxMovement to maxMovement)
        // Reversed the direction (1 - scrollProgress) for a standard "slower than scroll" parallax feel.
        const yOffset = ((1 - scrollProgress) * 2 - 1) * maxMovement;

        bg.style.transform = `translate3d(0, ${yOffset}px, 0)`;
      }
    });
    parallaxRafId = null;
  }

  function initParallax() {
    if (parallaxInitialized) return;

    const sections = document.querySelectorAll('.banner-cta-section');
    if (!sections.length) return;

    window.addEventListener('scroll', handleParallaxScroll, { passive: true });

    // Trigger once on load
    updateParallax();

    parallaxInitialized = true;
  }

  function cleanupParallax() {
    window.removeEventListener('scroll', handleParallaxScroll);
    parallaxInitialized = false;
    if (parallaxRafId) {
      cancelAnimationFrame(parallaxRafId);
      parallaxRafId = null;
    }
  }

  // Handle Astro page transitions if they are used
  document.addEventListener('astro:page-load', initParallax);
  document.addEventListener('astro:before-swap', cleanupParallax);

  // Initialize immediately if it's the first load
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initParallax();
  } else {
    document.addEventListener('DOMContentLoaded', initParallax);
  }
</script>
